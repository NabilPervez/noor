# Copy to .env (git-ignored) and fill in.
NOOR_LIBRARY=D:/Code/book-reader/public/library
NOOR_DATA_DIR=data
# ollama:<model> (free, local) | claude-haiku | claude-sonnet (need ANTHROPIC_API_KEY)
NOOR_MODEL=ollama:qwen2.5:7b
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Refuse below this cosine similarity. Calibrated 2026-10-20 (scripts/calibrate.py): answerable >= 0.683, off-topic <= 0.614.
NOOR_MIN_SIMILARITY=0.65

# Book Reader deep links (F11), e.g. http://localhost:5173
NOOR_BOOK_READER_URL=
